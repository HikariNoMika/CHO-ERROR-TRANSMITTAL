# --- Patient data: never commit these -------------------------------------
# The SQLite database holds every patient record, including the uploaded ID and
# Empanelment images referenced by filename.
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# Runtime uploads and generated workbooks. Patient names appear in the generated
# filenames, e.g. EMPANELMENT_<patient name>_<date>_<id>.xlsx. The nested
# storage/*/.gitignore files already cover this; these rules are a deliberate
# second layer in case those are ever lost.
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore

# Screenshots may capture live patient records in the UI. Not verified safe, so
# excluded by default - remove this line to include them deliberately.
/Screenshot *.png

# Excel lock files, created while a workbook is open in Excel.
~$*.xlsx
~$*.xls
